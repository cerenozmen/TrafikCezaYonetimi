@model int
@{
    // Hata sayfası, kullanıcıların karşılaştığı hataları anlamalarına yardımcı olur. Hata koduna göre uygun başlık ve mesaj görüntülenir. Kullanıcılar ana sayfaya dönerek işlemlerine devam edebilirler.  
    var (baslik, mesaj) = Model switch
    {
        404 => ("Sayfa bulunamadı", "Aradığınız sayfa veya kayıt bulunamadı. Adres hatalı yazılmış olabilir."),
        403 => ("Yetkisiz erişim", "Bu sayfayı görüntüleme veya bu işlemi yapma yetkiniz bulunmuyor."),
        _ => ("Bir sorun oluştu", "İsteğiniz işlenirken bir sorun oluştu. Lütfen tekrar deneyin.")
    };
    ViewData["Title"] = baslik;
}

<div class="text-center py-5">
    <div class="display-4 text-muted mb-3">@Model</div>
    <h1 class="h3">@baslik</h1>
    <p class="text-muted mb-4">@mesaj</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
</div>