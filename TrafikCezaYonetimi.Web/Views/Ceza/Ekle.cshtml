@model CezaFormViewModel
@{
    ViewData["Title"] = "Yeni Ceza";
}

<h1 class="h3 mb-3">Yeni Ceza</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Ekle" method="post">
            <partial name="_CezaForm" model="Model" />

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}