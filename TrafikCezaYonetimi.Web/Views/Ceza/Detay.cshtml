@model CezaDetayViewModel
@{
    var ceza = Model.Ceza;
    ViewData["Title"] = $"Ceza {ceza.TutanakNo}";

    var gecmis = ceza.OnayGecmisleri
        .OrderBy(g => g.IslemTarihi)
        .ThenBy(g => g.Id)
        .ToList();

    var sonRet = gecmis.LastOrDefault(g => g.IslemTipi == IslemTipi.Reddedildi);
    var rowVersion = Convert.ToBase64String(ceza.RowVersion);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        Ceza @ceza.TutanakNo
        <span class="badge @ceza.Durum.BadgeSinifi() fs-6 align-middle">@ceza.Durum.GorunenAd()</span>
    </h1>
    <div>
        @if (Model.DuzenleyebilirMi)
        {
            <a asp-action="Duzenle" asp-route-id="@ceza.Id" class="btn btn-outline-primary">Düzenle</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
</div>

@if (ceza.Durum == CezaDurumu.Reddedildi && sonRet is not null)
{
    <div class="alert alert-danger">
        <strong>Bu ceza reddedildi.</strong>
        @sonRet.Kullanici.Email tarafından @sonRet.IslemTarihi.ToString("dd.MM.yyyy HH:mm") tarihinde.
        <br />
        <strong>Ret nedeni:</strong> @sonRet.Aciklama
    </div>
}

<div class="row">
    <!-- Ceza bilgileri -->
    <div class="col-lg-7 mb-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Ceza Bilgileri</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Araç</dt>
                    <dd class="col-sm-8">
                        @ceza.Arac.Plaka - @ceza.Arac.Marka @ceza.Arac.Model
                        (@ceza.Arac.AracTipi.GorunenAd())
                    </dd>

                    <dt class="col-sm-4">Ceza Tarihi</dt>
                    <dd class="col-sm-8">@ceza.CezaTarihi.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Tutar</dt>
                    <dd class="col-sm-8">@ceza.Tutar.ParaFormatla()</dd>

                    <dt class="col-sm-4">İhlal Açıklaması</dt>
                    <dd class="col-sm-8">@ceza.IhlalAciklamasi</dd>

                    <dt class="col-sm-4">Oluşturan</dt>
                    <dd class="col-sm-8">@ceza.OlusturanKullanici.Email</dd>

                    <dt class="col-sm-4">Oluşturma Tarihi</dt>
                    <dd class="col-sm-8">@ceza.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- İşlemler -->
    <div class="col-lg-5 mb-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">İşlemler</div>
            <div class="card-body">

                @if (Model.OnayaGonderebilirMi)
                {
                    <form asp-action="OnayaGonder" asp-route-id="@ceza.Id" method="post">
                        <input type="hidden" name="rowVersion" value="@rowVersion" />
                        <p class="text-muted small">
                            Ceza yönetici onayına gönderilecek. Gönderildikten sonra düzenleme yapılamaz.
                        </p>
                        <button type="submit" class="btn btn-primary w-100">
                            @(ceza.Durum == CezaDurumu.Reddedildi ? "Yeniden Onaya Gönder" : "Onaya Gönder")
                        </button>
                    </form>
                }

                @if (Model.KararVerebilirMi)
                {
                    <form asp-action="Onayla" asp-route-id="@ceza.Id" method="post" class="mb-4">
                        <input type="hidden" name="rowVersion" value="@rowVersion" />
                        <label for="aciklama" class="form-label">Açıklama (isteğe bağlı)</label>
                        <textarea id="aciklama" name="aciklama" rows="2" maxlength="500" class="form-control mb-2"></textarea>
                        <button type="submit" class="btn btn-success w-100">Onayla</button>
                    </form>

                    <form asp-action="Reddet" asp-route-id="@ceza.Id" method="post"
                          onsubmit="return confirm('Bu cezayı reddetmek istediğinize emin misiniz?');">
                        <input type="hidden" name="rowVersion" value="@rowVersion" />
                        <label for="retNedeni" class="form-label">Ret nedeni <span class="text-danger">*</span></label>
                        <textarea id="retNedeni" name="retNedeni" rows="2" maxlength="500" required class="form-control mb-2"></textarea>
                        <button type="submit" class="btn btn-outline-danger w-100">Reddet</button>
                    </form>
                }

                @if (!Model.IslemYapabilirMi)
                {
                    <p class="text-muted mb-0">
                        @if (ceza.Durum == CezaDurumu.Tamamlandi)
                        {
                            <text>Onay süreci tamamlandı. Bu kayıt artık değiştirilemez.</text>
                        }
                        else
                        {
                            <text>Bu cezanın mevcut aşamasında sizin için yapılacak bir işlem yok.</text>
                        }
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Adım 7: Onay geçmişi -->
<div class="card">
    <div class="card-header fw-semibold">Onay Geçmişi</div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tarih</th>
                    <th>İşlem</th>
                    <th>Kullanıcı</th>
                    <th>Durum Değişikliği</th>
                    <th>Açıklama / Ret Nedeni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kayit in gecmis)
                {
                    <tr>
                        <td class="text-nowrap">@kayit.IslemTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <span class="badge @kayit.IslemTipi.BadgeSinifi()">@kayit.IslemTipi.GorunenAd()</span>
                        </td>
                        <td>@kayit.Kullanici.Email</td>
                        <td class="text-nowrap">
                            @(kayit.OncekiDurum?.GorunenAd() ?? "—")
                            →
                            <span class="badge @kayit.YeniDurum.BadgeSinifi()">@kayit.YeniDurum.GorunenAd()</span>
                        </td>
                        <td class="@(kayit.IslemTipi == IslemTipi.Reddedildi ? "text-danger" : "")">
                            @kayit.Aciklama
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>