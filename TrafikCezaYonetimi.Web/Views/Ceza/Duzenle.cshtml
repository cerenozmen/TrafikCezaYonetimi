@model CezaFormViewModel
@{
    ViewData["Title"] = "Ceza Düzenle";
}

<h1 class="h3 mb-3">Ceza Düzenle</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post">
            <partial name="_CezaForm" model="Model" />

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}