@model AracFormViewModel
@{
    ViewData["Title"] = "Yeni Araç";
}
// Yeni Araç sayfası, kullanıcıların sisteme yeni araç eklemelerini sağlar. Form, araç bilgilerini toplar ve doğrulama hatalarını gösterir.
<h1 class="h3 mb-3">Yeni Araç</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Ekle" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Plaka" class="form-label"></label>
                <input asp-for="Plaka" class="form-control" placeholder="34 ABC 123" />
                <span asp-validation-for="Plaka" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AracTipi" class="form-label"></label>
                <select asp-for="AracTipi" asp-items="Html.GetEnumSelectList<AracTipi>()" class="form-select">
                    <option value="">Seçiniz</option>
                </select>
                <span asp-validation-for="AracTipi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Marka" class="form-label"></label>
                <input asp-for="Marka" class="form-control" />
                <span asp-validation-for="Marka" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}