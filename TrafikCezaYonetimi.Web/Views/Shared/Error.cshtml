@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}
// Hata sayfası, kullanıcıların karşılaştığı beklenmeyen hataları anlamalarına yardımcı olur. Kullanıcılar ana sayfaya dönerek işlemlerine devam edebilirler. Hata kodu ve isteğin kimliği, sistem yöneticisine iletilebilir.   
<div class="text-center py-5">
    <h1 class="h3">Beklenmeyen bir hata oluştu</h1>
    <p class="text-muted mb-4">
        İşleminiz tamamlanamadı. Lütfen daha sonra tekrar deneyin.
        Sorun devam ederse sistem yöneticisine aşağıdaki hata kodunu iletin.
    </p>

    @if (Model.ShowRequestId)
    {
        <p><code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
</div>