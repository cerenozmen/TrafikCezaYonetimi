@using Microsoft.AspNetCore.Identity
@using TrafikCezaYonetimi.Web.Constants
@inject SignInManager<IdentityUser> SignInManager
@{
    var rol = Roller.Tumu.FirstOrDefault(r => User.IsInRole(r));
}

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item d-flex align-items-center me-2">
            <span class="navbar-text text-dark">
                @User.Identity?.Name
                @if (rol is not null)
                {
                    <span class="badge bg-secondary ms-1">@Roller.GorunenAd(rol)</span>
                }
            </span>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Çıkış Yap</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Giriş Yap</a>
        </li>
    }
</ul>